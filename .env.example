# Copy this file to .env.local and fill in the real values.
# .env.local is never saved to GitHub. These values below are FAKE.

# Supabase (Project Settings -> API). Added in Week 1, step 2.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=fake-publishable-key
# Server-only secret key, used to send teen login invites (Step 7c).
# NEVER prefix it with NEXT_PUBLIC_. In Vercel, mark it Sensitive.
SUPABASE_SECRET_KEY=fake-secret-key-never-share

# Mux video (Week 2). Vercel only, both marked Sensitive. Never NEXT_PUBLIC_.
MUX_TOKEN_ID=fake-mux-token-id
MUX_TOKEN_SECRET=fake-mux-token-secret
# Mux signing key (Settings -> Signing Keys) for private links to frames and videos.
MUX_SIGNING_KEY_ID=fake-signing-key-id
MUX_SIGNING_PRIVATE_KEY=fake-base64-private-key

# Automatic tests only: use a pretend video service. Ignored on Vercel.
# VIDEO_PROVIDER=fake
